rules_version = '2';

// Reglas de Firestore para DESPUÉS de la migración a la API (módulo M7 · cierre).
//
// La API (Admin SDK) es la única que escribe: ya no se aplican las reglas de negocio aquí, porque
// el Admin SDK las ignora y las valida la propia API. La app móvil solo LEE (listeners en tiempo
// real y caché sin conexión) y únicamente lo suyo o lo público (las jornadas); las cuentas ajenas y la
// auditoría solo las entrega la API; toda escritura directa del cliente se deniega.
//
// NO publicar hasta que la API esté desplegada y todas las instalaciones usen la versión de la
// app que llama a la API. Ver docs/migracion-api/05-despliegue-y-recuperacion.md.
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil: cada quien lee solo el suyo (rol y estado en vivo). La lista de cuentas del
    // administrador la entrega la API (GET /v1/admin/usuarios): ni siquiera un administrador
    // puede leer los perfiles ajenos directo de Firestore.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Jornadas: lectura para cualquier usuario con sesión (listados, detalle, "Mis jornadas")
    match /jornadas/{jornadaId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Inscripciones: cada alumno lee solo las suyas; la planilla de inscritos la entrega la API
    match /inscripciones/{inscripcionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Notificaciones: las crea la API; cada usuario lee solo las suyas
    match /notificaciones/{notificacionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Auditoría: la escribe y la lee solo la API (GET /v1/admin/auditoria)
    match /auditoria/{registroId} {
      allow read: if false;
      allow write: if false;
    }

    match /eventos_jornadas/{eventoId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
