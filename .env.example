# Copia este archivo a .env y completa tus credenciales de Firebase (Configuración del proyecto > Tus apps).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# API de negocio (opcional). Vacío = la app usa su lógica local anterior (Firestore + reglas).
# Con URL, la app envía las escrituras a la API.
EXPO_PUBLIC_API_URL=
# Módulos que usan la API (por defecto "todos"): sesion,inscripciones,jornadas,notificaciones,usuarios,reportes
EXPO_PUBLIC_API_MODULOS=
