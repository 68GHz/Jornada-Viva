# Copia este archivo a .env (cp .env.example .env). Para ejecutar la app no hay que cambiar nada.

# API de negocio. La app la usa para todas las escrituras y para la asistencia por QR.
# Vacía = modo local anterior (Firestore directo, sin asistencia por QR): no la dejes vacía.
EXPO_PUBLIC_API_URL=https://jornada-viva.onrender.com
# Módulos que usan la API (por defecto "todos"): sesion,inscripciones,jornadas,notificaciones,usuarios,reportes
EXPO_PUBLIC_API_MODULOS=

# Solo las lee scripts/admin.js (Configuración del proyecto > Tus apps en la consola de Firebase).
# La app NO las lee: su configuración de Firebase está en firebaseConfig.js.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
