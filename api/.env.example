# Copia este archivo a .env (NO lo subas al repositorio) o define estas variables en el hosting.

# Puerto HTTP (los hostings suelen fijarlo ellos mismos)
PORT=8080

# Proyecto de Firebase
FIREBASE_PROJECT_ID=jornadaviva-476ff

# Clave de la cuenta de servicio (Firebase Console > Configuración del proyecto > Cuentas de
# servicio > Generar nueva clave privada). Pega el JSON completo en una sola línea, o su base64.
# Es un SECRETO del servidor: nunca en el repositorio ni en la app móvil.
FIREBASE_SERVICE_ACCOUNT=

# Orígenes web permitidos por CORS, separados por coma. La app móvil no lo necesita: déjalo vacío.
CORS_ORIGINS=

# Cada cuántos minutos se desactivan las jornadas vencidas (0 = solo bajo demanda)
MANTENIMIENTO_MINUTOS=5
