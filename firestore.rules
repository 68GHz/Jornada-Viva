rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ================= Roles =================
    // El rol está en users/{uid}.rol: "estudiante" (o sin rol), "gestor" (antes "maestro",
    // que se sigue aceptando hasta migrar los datos) o "administrador". Solo un
    // administrador lo asigna (o scripts/admin.js con credenciales del proyecto).
    // `activo: false` desactiva la cuenta: deja de poder escribir.
    function perfilDe(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function cuentaActiva(perfil) {
      return perfil.get('activo', true) != false;
    }

    function rolDe(uid) {
      return perfilDe(uid).get('rol', 'estudiante');
    }

    function tienePerfil(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    // Cualquier usuario con sesión cuya cuenta no esté desactivada
    function usuarioActivo() {
      return request.auth != null
        && (!tienePerfil(request.auth.uid) || cuentaActiva(perfilDe(request.auth.uid)));
    }

    function esAdmin() {
      return request.auth != null
        && tienePerfil(request.auth.uid)
        && cuentaActiva(perfilDe(request.auth.uid))
        && rolDe(request.auth.uid) == 'administrador';
    }

    function esGestor() {
      return request.auth != null
        && tienePerfil(request.auth.uid)
        && cuentaActiva(perfilDe(request.auth.uid))
        && rolDe(request.auth.uid) in ['gestor', 'maestro'];
    }

    // Quién puede tener jornadas asignadas
    function puedeSerResponsable(uid) {
      return tienePerfil(uid)
        && cuentaActiva(perfilDe(uid))
        && rolDe(uid) in ['gestor', 'maestro', 'administrador'];
    }

    // Una jornada está asignada al gestor que figura en `creadoPor`. Las anteriores a los
    // roles no lo tienen: solo un administrador las gestiona.
    function esPropietario(jornada) {
      return jornada.get('creadoPor', null) == request.auth.uid;
    }

    function esPropietarioDeJornada(jornadaId) {
      return esGestor()
        && esPropietario(get(/databases/$(database)/documents/jornadas/$(jornadaId)).data);
    }

    // ================= Usuarios =================
    match /users/{userId} {
      // Cada quien lee su perfil; el administrador, todos
      allow read: if request.auth != null && (request.auth.uid == userId || esAdmin());

      // Al registrarse solo se puede ser estudiante activo; el administrador crea cuentas con cualquier rol
      allow create: if request.auth != null
        && ((request.auth.uid == userId
             && request.resource.data.get('rol', 'estudiante') == 'estudiante'
             && request.resource.data.get('activo', true) == true)
            || (esAdmin()
                && request.resource.data.get('rol', 'estudiante') in ['estudiante', 'gestor', 'administrador']
                && request.resource.data.get('activo', true) is bool));

      allow update: if request.auth != null
        && (
          // Perfil propio: el rol y el estado de la cuenta no se pueden cambiar a sí mismo
          // (solo pasar de "sin rol" a estudiante). Vale también para un administrador.
          (request.auth.uid == userId
            && (request.resource.data.get('rol', null) == resource.data.get('rol', null)
                || (resource.data.get('rol', null) == null
                    && request.resource.data.get('rol', null) == 'estudiante'))
            && request.resource.data.get('activo', true) == resource.data.get('activo', true))
          // Cuentas de otros: solo el administrador (rol, estado y datos)
          || (esAdmin()
              && request.auth.uid != userId
              && request.resource.data.get('rol', 'estudiante') in ['estudiante', 'gestor', 'administrador']
              && request.resource.data.get('activo', true) is bool)
        );

      allow delete: if false;
    }

    // ================= Jornadas =================
    function textoValido(valor, maximo) {
      return valor is string && valor.size() > 0 && valor.size() <= maximo;
    }

    function jornadaValida(d) {
      return d.keys().hasOnly([
          'titulo', 'descripcion', 'entidad', 'responsable', 'lugar', 'fecha',
          'cuposTotales', 'cuposOcupados', 'activa', 'creadoPor', 'creadaEn'
        ])
        && d.keys().hasAll([
          'titulo', 'descripcion', 'entidad', 'responsable', 'lugar', 'fecha',
          'cuposTotales', 'cuposOcupados', 'activa', 'creadoPor'
        ])
        && textoValido(d.titulo, 120)
        && textoValido(d.descripcion, 2000)
        && textoValido(d.entidad, 120)
        && textoValido(d.responsable, 120)
        && d.lugar in [
          'Bloque 1', 'Bloque 2', 'Bloque 3', 'Bloque 4', 'Bloque 5', 'Bloque 6',
          'Bloque 7', 'Bloque 8', 'Bloque 9', 'Bloque 10', 'Bloque 11', 'Bloque 12',
          'Bloque 13', 'Auditorio', 'Cancha', 'Coliseo'
        ]
        && d.fecha is timestamp
        && d.cuposTotales is int && d.cuposTotales >= 1 && d.cuposTotales <= 1000
        && d.cuposOcupados is int
        && d.activa is bool;
    }

    // Administración de una jornada asignada: editar, cancelar y reactivar
    function edicionDelPropietario() {
      let antes = resource.data;
      let d = request.resource.data;
      return esGestor()
        && esPropietario(antes)
        && jornadaValida(d)
        && d.creadoPor == antes.creadoPor
        && d.cuposOcupados == antes.cuposOcupados
        && d.cuposTotales >= antes.cuposOcupados
        && (!('creadaEn' in antes) || d.creadaEn == antes.creadaEn)
        && (d.activa == false || d.fecha > request.time);
    }

    // El administrador edita cualquier jornada y puede reasignarla a otro gestor
    function edicionDelAdmin() {
      let antes = resource.data;
      let d = request.resource.data;
      return esAdmin()
        && jornadaValida(d)
        && d.cuposOcupados == antes.cuposOcupados
        && d.cuposTotales >= antes.cuposOcupados
        && (!('creadaEn' in antes) || d.creadaEn == antes.creadaEn)
        && (d.activa == false || d.fecha > request.time)
        && (d.creadoPor == antes.get('creadoPor', null) || puedeSerResponsable(d.creadoPor));
    }

    // Inscribirse / cancelar una inscripción solo mueve el contador de cupos
    function soloCupos() {
      let cambios = request.resource.data.diff(resource.data).affectedKeys();
      return cambios.hasOnly(['cuposOcupados'])
        && request.resource.data.cuposOcupados is int
        && request.resource.data.cuposOcupados >= 0
        && request.resource.data.cuposOcupados <= resource.data.cuposTotales;
    }

    // Cualquier usuario puede desactivar una jornada cuya fecha ya pasó
    function soloVencimiento() {
      let cambios = request.resource.data.diff(resource.data).affectedKeys();
      return cambios.hasOnly(['activa'])
        && request.resource.data.activa == false
        && resource.data.get('fecha', null) is timestamp
        && resource.data.fecha <= request.time;
    }

    match /jornadas/{jornadaId} {
      allow read: if request.auth != null;

      // Un gestor crea jornadas a su nombre; el administrador, para cualquier gestor
      allow create: if ((esGestor() && request.resource.data.creadoPor == request.auth.uid)
            || (esAdmin() && puedeSerResponsable(request.resource.data.creadoPor)))
        && jornadaValida(request.resource.data)
        && request.resource.data.cuposOcupados == 0
        && request.resource.data.activa == true
        && request.resource.data.fecha > request.time
        && (!('creadaEn' in request.resource.data) || request.resource.data.creadaEn == request.time);

      allow update: if usuarioActivo()
        && (edicionDelPropietario() || edicionDelAdmin() || soloCupos() || soloVencimiento());

      allow delete: if esAdmin() || (esGestor() && esPropietario(resource.data));
    }

    // ================= Inscripciones =================
    function jornadaDeInscripcion(jornadaId) {
      return get(/databases/$(database)/documents/jornadas/$(jornadaId)).data;
    }

    function ventanaAsistenciaValida(jornadaFecha) {
      return request.time >= jornadaFecha
        && request.time <= jornadaFecha + duration.value(20, 'm');
    }

    match /inscripciones/{inscripcionId} {
      // El estudiante lee las suyas; el gestor, las de sus jornadas (planilla); el administrador, todas
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || esAdmin()
            || esPropietarioDeJornada(resource.data.jornadaId));

      allow create: if usuarioActivo()
        && request.resource.data.userId == request.auth.uid;

      // Actualización: exclusivamente para registro de asistencia durante los primeros 20 minutos
      allow update: if request.auth != null && (
        // Asistencia autónoma por el estudiante inscrito:
        (
          resource.data.userId == request.auth.uid
          && usuarioActivo()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['asistio', 'asistioEn', 'metodoAsistencia'])
          && request.resource.data.asistio == true
          && request.resource.data.get('metodoAsistencia', 'qr') in ['qr', 'autonoma']
          && ventanaAsistenciaValida(jornadaDeInscripcion(resource.data.jornadaId).fecha)
        )
        // Asistencia manual por el gestor de la jornada o administrador:
        || (
          (esAdmin() || esPropietarioDeJornada(resource.data.jornadaId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['asistio', 'asistioEn', 'metodoAsistencia'])
          && request.resource.data.asistio is bool
          && (!('metodoAsistencia' in request.resource.data) || request.resource.data.metodoAsistencia in ['manual', 'qr', 'autonoma'])
          && ventanaAsistenciaValida(jornadaDeInscripcion(resource.data.jornadaId).fecha)
        )
      );

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Reglas para notificaciones individuales por usuario
    match /notificaciones/{notificacionId} {
      // El usuario solo puede leer sus propias notificaciones
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // El usuario solo puede actualizar el estado de lectura de sus propias notificaciones
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida', 'leidaEn']);

      // Creación permitida solo para el propio usuario o mediante backend/admin SDK
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      // El usuario puede eliminar sus propias notificaciones
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Auditoría de acciones administrativas: solo el administrador escribe (a su nombre) y lee;
    // los registros no se pueden modificar ni borrar.
    match /auditoria/{registroId} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly(
             ['accion', 'entidad', 'entidadId', 'detalle', 'actorId', 'actorNombre', 'creadaEn'])
        && request.resource.data.keys().hasAll(['accion', 'entidad', 'entidadId', 'actorId', 'creadaEn'])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.creadaEn == request.time
        && textoValido(request.resource.data.accion, 60)
        && textoValido(request.resource.data.entidad, 40)
        && request.resource.data.entidadId is string
        && (!('detalle' in request.resource.data)
            || (request.resource.data.detalle is string && request.resource.data.detalle.size() <= 500));
      allow update, delete: if false;
    }

    // Historial / eventos de cambios en jornadas (auditoría / sincronización)
    match /eventos_jornadas/{eventoId} {
      allow read: if request.auth != null;
      // Solo administradores / backend crean eventos directamente o usuarios autenticados registrando eventos del sistema
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
