rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ================= Roles =================
    // El rol está en users/{uid}.rol ("maestro" | "estudiante"). Sin rol = estudiante.
    // Solo se asigna fuera de la app (consola de Firebase o scripts/admin.js).
    function esMaestro() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('rol', 'estudiante') == 'maestro';
    }

    // Una jornada es de quien la creó. Las anteriores a los roles no tienen `creadoPor`
    // y por eso ningún maestro puede administrarlas.
    function esPropietario(jornada) {
      return jornada.get('creadoPor', null) == request.auth.uid;
    }

    function esPropietarioDeJornada(jornadaId) {
      return esMaestro()
        && esPropietario(get(/databases/$(database)/documents/jornadas/$(jornadaId)).data);
    }

    // ================= Usuarios =================
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Al registrarse solo se puede ser estudiante
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.get('rol', 'estudiante') == 'estudiante';

      // El rol no se puede cambiar desde la app (solo pasar de "sin rol" a estudiante)
      allow update: if request.auth != null
        && request.auth.uid == userId
        && (request.resource.data.get('rol', null) == resource.data.get('rol', null)
            || (resource.data.get('rol', null) == null
                && request.resource.data.get('rol', null) == 'estudiante'));

      allow delete: if false;
    }

    // ================= Jornadas =================
    function textoValido(valor, maximo) {
      return valor is string && valor.size() > 0 && valor.size() <= maximo;
    }

    function jornadaValida(d) {
      return d.keys().hasOnly([
          'titulo', 'descripcion', 'entidad', 'responsable', 'lugar', 'fecha',
          'cuposTotales', 'cuposOcupados', 'activa', 'creadoPor', 'creadaEn'
        ])
        && d.keys().hasAll([
          'titulo', 'descripcion', 'entidad', 'responsable', 'lugar', 'fecha',
          'cuposTotales', 'cuposOcupados', 'activa', 'creadoPor'
        ])
        && textoValido(d.titulo, 120)
        && textoValido(d.descripcion, 2000)
        && textoValido(d.entidad, 120)
        && textoValido(d.responsable, 120)
        && d.lugar in [
          'Bloque 1', 'Bloque 2', 'Bloque 3', 'Bloque 4', 'Bloque 5', 'Bloque 6',
          'Bloque 7', 'Bloque 8', 'Bloque 9', 'Bloque 10', 'Bloque 11', 'Bloque 12',
          'Bloque 13', 'Auditorio', 'Cancha', 'Coliseo'
        ]
        && d.fecha is timestamp
        && d.cuposTotales is int && d.cuposTotales >= 1 && d.cuposTotales <= 1000
        && d.cuposOcupados is int
        && d.activa is bool;
    }

    // Administración de una jornada propia: editar, cancelar y reactivar
    function edicionDelPropietario() {
      let antes = resource.data;
      let d = request.resource.data;
      return esMaestro()
        && esPropietario(antes)
        && jornadaValida(d)
        && d.creadoPor == antes.creadoPor
        && d.cuposOcupados == antes.cuposOcupados
        && d.cuposTotales >= antes.cuposOcupados
        && (!('creadaEn' in antes) || d.creadaEn == antes.creadaEn)
        && (d.activa == false || d.fecha > request.time);
    }

    // Inscribirse / cancelar una inscripción solo mueve el contador de cupos
    function soloCupos() {
      let cambios = request.resource.data.diff(resource.data).affectedKeys();
      return cambios.hasOnly(['cuposOcupados'])
        && request.resource.data.cuposOcupados is int
        && request.resource.data.cuposOcupados >= 0
        && request.resource.data.cuposOcupados <= resource.data.cuposTotales;
    }

    // Cualquier usuario puede desactivar una jornada cuya fecha ya pasó
    function soloVencimiento() {
      let cambios = request.resource.data.diff(resource.data).affectedKeys();
      return cambios.hasOnly(['activa'])
        && request.resource.data.activa == false
        && resource.data.get('fecha', null) is timestamp
        && resource.data.fecha <= request.time;
    }

    match /jornadas/{jornadaId} {
      allow read: if request.auth != null;

      // Solo un maestro crea jornadas y siempre a su nombre
      allow create: if esMaestro()
        && jornadaValida(request.resource.data)
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.cuposOcupados == 0
        && request.resource.data.activa == true
        && request.resource.data.fecha > request.time
        && (!('creadaEn' in request.resource.data) || request.resource.data.creadaEn == request.time);

      allow update: if request.auth != null
        && (edicionDelPropietario() || soloCupos() || soloVencimiento());

      allow delete: if esMaestro() && esPropietario(resource.data);
    }

    // ================= Inscripciones =================
    match /inscripciones/{inscripcionId} {
      // El estudiante lee las suyas; el maestro, las de sus propias jornadas (planilla)
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || esPropietarioDeJornada(resource.data.jornadaId));

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow update: if false;

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Reglas para notificaciones individuales por usuario
    match /notificaciones/{notificacionId} {
      // El usuario solo puede leer sus propias notificaciones
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // El usuario solo puede actualizar el estado de lectura de sus propias notificaciones
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida', 'leidaEn']);

      // Creación permitida solo para el propio usuario o mediante backend/admin SDK
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      // El usuario puede eliminar sus propias notificaciones
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Historial / eventos de cambios en jornadas (auditoría / sincronización)
    match /eventos_jornadas/{eventoId} {
      allow read: if request.auth != null;
      // Solo administradores / backend crean eventos directamente o usuarios autenticados registrando eventos del sistema
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
